{
  extends: [
    'config:recommended',
  ],
  labels: [
    'automation',
  ],
  enabledManagers: [
    'custom.regex',
  ],
  packageRules: [
    {
      matchManagers: [
        'custom.regex',
      ],
      groupName: 'otelcol',
    },
    {
      // Components from this repository are built from local source via
      // `replaces` in the distribution manifests; their versions there are
      // a v0.0.0 placeholder and must not be updated.
      matchManagers: [
        'custom.regex',
      ],
      matchPackageNames: [
        'github.com/elastic/opentelemetry-collector-components/**',
      ],
      enabled: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      fileMatch: [
        'distributions/elastic-components/manifest.yaml$',
      ],
      datasourceTemplate: 'go',
      matchStrings: [
        'gomod: (?<depName>.+) (?<currentValue>.+)',
      ],
    },
  ],
}
