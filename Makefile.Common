SHELL = /usr/bin/env bash

GOTEST_TIMEOUT?=240s
GOTEST_OPT?= -race -cover -timeout $(GOTEST_TIMEOUT)
GOTEST_INTEGRATION_OPT?= $(GOTEST_OPT) -parallel 4 -tags=integration
GOCMD?= go
GOTEST=$(GOCMD) test
GOOS := $(shell $(GOCMD) env GOOS)
GOARCH := $(shell $(GOCMD) env GOARCH)


# SRC_ROOT is the top of the source tree.
SRC_ROOT := $(shell git rev-parse --show-toplevel)

# Tools are declared in $(TOOLS_MOD_DIR)/go.mod using tool directives.
TOOLS_MOD_DIR := $(SRC_ROOT)/internal/tools

# Resolve tool binaries from the tools module. Use -n so the binary runs in the
# caller's working directory (go tool -C would change cwd and break tools that
# look for local files/modules).
#
# On Windows, `go tool -n` returns paths with backslashes which break under
# MSYS2/Git Bash; $(subst \,/,...) converts them to forward slashes.
GO_TOOL = GOOS= GOARCH= $(GOCMD) tool -C $(TOOLS_MOD_DIR)
LINT = $(subst \,/,$(shell $(GO_TOOL) -n github.com/golangci/golangci-lint/v2/cmd/golangci-lint))
MISSPELL = $(subst \,/,$(shell $(GO_TOOL) -n github.com/client9/misspell/cmd/misspell))
MDATAGEN = $(subst \,/,$(shell $(GO_TOOL) -n go.opentelemetry.io/collector/cmd/mdatagen))
GOVULNCHECK = $(subst \,/,$(shell $(GO_TOOL) -n golang.org/x/vuln/cmd/govulncheck))
GOJQ = $(subst \,/,$(shell $(GO_TOOL) -n github.com/itchyny/gojq/cmd/gojq))
PORTO = $(subst \,/,$(shell $(GO_TOOL) -n github.com/jcchavezs/porto/cmd/porto))
BUILDER = $(subst \,/,$(shell $(GO_TOOL) -n go.opentelemetry.io/collector/cmd/builder))
LICENSER = $(subst \,/,$(shell $(GO_TOOL) -n github.com/elastic/go-licenser))
CHLOGGEN = $(subst \,/,$(shell $(GO_TOOL) -n go.opentelemetry.io/build-tools/chloggen))
MULTIMOD = $(subst \,/,$(shell $(GO_TOOL) -n go.opentelemetry.io/build-tools/multimod))
GOIMPORTS = $(subst \,/,$(shell $(GO_TOOL) -n golang.org/x/tools/cmd/goimports))

# Ignored vulnerabilities with justification:
# - GO-2026-5662: False positive, we use `github.com/prometheus/prometheus`
#   >= 0.312.0, which has the fix for this vulnerability. Besides, this doesn't
#   affect the Collector in any way, only the Prometheus UI.
IGNORED_VULNS = GO-2026-5662

# Ignore all golang-related vulnerabilities (stdlib, golang.org/x/*, google.golang.org/*, etc.)
IGNORE_GOLANG_VULNS ?=

# Download tools module deps and warm the go tool cache.
.PHONY: install-tools
install-tools:
	cd $(TOOLS_MOD_DIR) && $(GOCMD) mod download
	@$(GO_TOOL) -n github.com/client9/misspell/cmd/misspell >/dev/null
	@$(GO_TOOL) -n github.com/elastic/go-licenser >/dev/null
	@$(GO_TOOL) -n github.com/golangci/golangci-lint/v2/cmd/golangci-lint >/dev/null
	@$(GO_TOOL) -n github.com/itchyny/gojq/cmd/gojq >/dev/null
	@$(GO_TOOL) -n github.com/jcchavezs/porto/cmd/porto >/dev/null
	@$(GO_TOOL) -n go.opentelemetry.io/build-tools/chloggen >/dev/null
	@$(GO_TOOL) -n go.opentelemetry.io/build-tools/multimod >/dev/null
	@$(GO_TOOL) -n go.opentelemetry.io/collector/cmd/builder >/dev/null
	@$(GO_TOOL) -n go.opentelemetry.io/collector/cmd/mdatagen >/dev/null
	@$(GO_TOOL) -n golang.org/x/tools/cmd/goimports >/dev/null
	@$(GO_TOOL) -n golang.org/x/vuln/cmd/govulncheck >/dev/null

.PHONY: test
test:
	$(GOTEST) $(GOTEST_OPT) ./...

.PHONY: integration-test
integration-test:
	$(GOTEST) $(GOTEST_INTEGRATION_OPT) ./...

.PHONY: fmt
fmt:
	gofmt -w -s ./

.PHONY: tidy
tidy:
	rm -fr go.sum
	$(GOCMD) mod tidy -compat=1.21.0

.PHONY: license-check
license-check:
	@$(LICENSER) -d

.PHONY: license-update
license-update:
	@$(LICENSER)

.PHONY: misspell
misspell:
	@echo "running misspell"
	@$(MISSPELL) $$(find . \( -name "*.md" -o -name "*.yaml" \) -type f | sort)

.PHONY: lint
lint: misspell
	$(LINT) run --allow-parallel-runners --verbose --build-tags integration --timeout=30m --path-prefix $(shell basename "$(CURDIR)")

.PHONY: generate
generate:
	$(GOCMD) generate ./...
	$(GOIMPORTS) -w ./

.PHONY: moddownload
moddownload:
	$(GOCMD) mod download

.PHONY: porto
porto:
	$(PORTO) -w --include-internal --skip-dirs "^cmd$$" ./

# jq filter: Build OSV lookup map {id: {withdrawn, summary, pkg}}
_GOVUL_MAP = reduce (.[] | select(.osv)) as $$osv ({}; . + {($$osv.osv.id): {summary: $$osv.osv.summary, withdrawn: $$osv.osv.withdrawn, pkg: ($$osv.osv.affected[0].package.name // "")}}) as $$osv_data
# jq filter: Check if vulnerability should be skipped (withdrawn, golang+IGNORE_GOLANG_VULNS, or has no position/symbol in trace)
_GOVUL_SKIP = ($$osv_data[.finding.osv].withdrawn | . != null and . != "") or ("$(IGNORE_GOLANG_VULNS)" == "1" and ($$osv_data[.finding.osv].pkg | test("^(stdlib|golang\\.org|google\\.golang\\.org)"))) or (.finding.trace | length == 0 or (all(.position == null and .symbol == null)))
.PHONY: govulncheck
govulncheck:
	@set -e; \
	$(GOVULNCHECK) -format json ./... > govulncheck-output.json; \
	FOUND="$$( $(GOJQ) -r -s '$(_GOVUL_MAP) | [.[] | select(.finding != null and ($(_GOVUL_SKIP) | not)) | .finding.osv] | unique | .[]' govulncheck-output.json | sort -u )"; \
	[ -z "$$FOUND" ] && echo "No vulnerabilities found" && rm -f govulncheck-output.json && exit 0; \
	echo "Found: $$FOUND"; \
	\
	UNIGNORED=""; \
	for id in $$FOUND; do \
		echo "$(IGNORED_VULNS)" | grep -qw "$$id" || UNIGNORED="$$UNIGNORED $$id"; \
	done; \
	UNIGNORED="$$(echo $$UNIGNORED | xargs)"; \
	[ -z "$$UNIGNORED" ] && echo "All vulnerabilities ignored" && rm -f govulncheck-output.json && exit 0; \
	\
	echo "Vulnerabilities need attention: $$UNIGNORED"; \
	echo ""; \
	echo "Vulnerability Summary:"; \
	echo "ID/LINK    SUMMARY    POSITION"; \
	$(GOJQ) -r -s '$(_GOVUL_MAP) | [.[] | select(.finding != null and ($(_GOVUL_SKIP) | not)) | ["https://pkg.go.dev/vuln/" + .finding.osv, $$osv_data[.finding.osv].summary, (.finding.trace | map(select(.position != null or .symbol != null) | (.position // .symbol | tostring)) | join("; "))] ] | unique_by(.[0]) | .[] | @tsv' govulncheck-output.json; \
	rm -f govulncheck-output.json; \
	exit 1

.PHONY: toolchain
toolchain:
	$(GOCMD) get toolchain@none
